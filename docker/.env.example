# =============================================================================
# Template for docker/.env - copy to docker/.env and fill in real values.
#   cp docker/.env.example docker/.env
#
# docker/.env is git-ignored on purpose: NEVER commit a real connection string,
# password or signing key. The legacy application committed its 3DES
# decryptionKey to source control (Website/release.config); that mistake is not
# repeated here.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Points at the EXISTING, UNALTERED DotNetNuke SQL Server schema (dbo, empty
# objectQualifier). Consumed by docker-compose.yml as ConnectionStrings__Default.
# host.docker.internal reaches a SQL Server running on the container host;
# use the service/host name of your SQL Server when it runs elsewhere.
DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DotNetNuke;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True

# --- JWT ----------------------------------------------------------------------
# Minimum 32 characters (256 bits) for HMAC-SHA256 signing.
JWT_SECRET=CHANGE_ME_generate_a_random_32_byte_minimum_secret
JWT_ISSUER=DnnMigration
JWT_AUDIENCE=DnnMigration
JWT_EXPIRATION_MINUTES=60

# --- CORS ---------------------------------------------------------------------
# Exact origin of the Angular SPA. Never combine a wildcard origin with
# credentials.
FRONTEND_ORIGIN=http://localhost:4200
