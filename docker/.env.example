# =============================================================================
# docker/.env.example - TEMPLATE for the values docker/docker-compose.yml and
#                       docker/docker-compose.tls.yml interpolate.
#
#   cp docker/.env.example docker/.env      # then edit docker/.env
#
# Compose reads `.env` from the directory that CONTAINS the compose file, so it
# must be docker/.env; a .env at the repository root is not read. Exporting the
# same names in the invoking shell works identically and takes precedence, which
# is how a real deployment should supply them - from the orchestrator's secret
# store rather than from a file on disk.
#
# NEVER COMMIT docker/.env. It holds real credentials. .gitignore enforces that
# with `.env*` / `*.env` plus a `!**/.env.example` negation that keeps THIS file,
# and only this file, tracked. Confirm both halves before committing:
#       git check-ignore -v docker/.env           # expect a match: ignored
#       git check-ignore -v docker/.env.example   # expect no match: tracked
# The application this API replaces committed the key that decrypted every stored
# password; ending that practice is one of the goals of the migration, so no
# secret - not a real one, not a convincing sample - is written into a tracked
# file here.
#
# FILE FORMAT. KEY=value, one entry per line, no spaces around `=`, no `export`
# prefix, no quotes, no line continuations; `#` begins a comment. Do not quote a
# value: Compose keeps the quote characters and they become part of the value.
# Semicolons need no escaping - this is not a shell script.
#
# THERE IS NO DATABASE CONTAINER. The compose file declares two services, `api`
# and `frontend`. SQL Server is always EXTERNAL and must already hold the existing
# DotNetNuke schema; the API maps onto that schema and never creates, alters or
# drops any part of it.
#
# HOW THESE VALUES REACH THE API, AND WHO CAN READ THEM. Compose passes each one
# in as an ENVIRONMENT VARIABLE - `ConnectionStrings__Default=${DB_CONNECTION_STRING}`,
# `Jwt__Secret=${JWT_SECRET}` - which is what the preserved container example
# (AAP 0.9.3) declares. An environment variable is readable from several places by
# anyone with the corresponding access, and all of them should be assumed:
#   * the container's own metadata, through the Docker socket or API;
#   * the process environment inside the container, for anything that can exec
#     into it or read /proc as the right user;
#   * this file, and any shell history or CI log that carried the values;
#   * a `docker compose config` rendering, which interpolates them.
# To check that a variable is PRESENT without printing it - never grep the value
# itself into a terminal, a ticket or a CI log:
#       docker inspect dnnmigration-api \
#         --format '{{range .Config.Env}}{{println (index (split . "=") 0)}}{{end}}' \
#         | grep -x Jwt__Secret          # prints only the NAME if it is set
#
# WHAT THIS ARRANGEMENT DOES NOT PROTECT AGAINST, STATED PLAINLY
#   Every value below reaches the API as an ENVIRONMENT VARIABLE, because that is
#   what the compose file the migration plan preserves (AAP 0.9.3) declares:
#   `ConnectionStrings__Default=${DB_CONNECTION_STRING}` and
#   `Jwt__Secret=${JWT_SECRET}`. An environment variable is readable from the
#   container's own metadata, so ANY user or process that can reach the Docker
#   socket can recover both values from a RUNNING container:
#       docker inspect dnnmigration-api | grep Jwt__Secret
#   Runtime testing confirmed that this is the ONLY surface that exposes them.
#   Neither value appears in either image's history, in its layers, in its
#   configuration, anywhere on the API image's filesystem, in the served frontend
#   bundle, or in either container's logs - all measured at zero occurrences,
#   including for an issued access token. The exposure is confined to live-container
#   inspection, and it follows from the frozen example rather than from a choice
#   made here.
#
#   FOR A DEPLOYMENT THAT CANNOT ACCEPT THAT, THERE IS A SUPPORTED FILE ROUTE THAT
#   THE HOST ACTUALLY READS. This paragraph used to say the values could move to
#   mounted files "without any code change" - and no key-per-file configuration
#   source was registered anywhere, so a /run/secrets mount was simply not read.
#   The claim now describes a registered source:
#
#     * ONE FILE PER KEY, IN /run/secrets, AND THE FILE NAME IS THE KEY. The host
#       registers a key-per-file source over that directory, and the file name is
#       translated exactly as an environment variable name is - a double underscore
#       becomes the section separator. So:
#           /run/secrets/ConnectionStrings__Default  ->  ConnectionStrings:Default
#           /run/secrets/Jwt__Secret                 ->  Jwt:Secret
#       Those two are the only keys this API requires from a secret store; the
#       optional LegacyCredentials__DecryptionKey can be delivered the same way. A
#       trailing newline is trimmed, so a file written by an editor or by `echo`
#       carries the value it looks like it carries.
#     * COMPOSE'S OWN `secrets:` IS THE SMALLEST STEP, because it mounts each
#       declared secret at /run/secrets/<target> - name the target for the key and
#       delete the matching `environment:` line. Docker Swarm and a Kubernetes
#       secret volume produce the same shape; a Kubernetes PROJECTED volume is
#       conventionally mounted elsewhere, which is what `Secrets__Directory`
#       (configuration key Secrets:Directory) is for - set it to the mount path and
#       the same image reads from there.
#     * PRECEDENCE: A MOUNTED FILE WINS. The source is added after the environment,
#       so a mounted secret outranks an environment variable of the same name. That
#       is the direction a deployment wants - mounting the file is how the value is
#       kept OUT of the inspectable environment block, and an inherited variable
#       must not silently defeat it - and it makes the move one step rather than a
#       cutover. Verified by running the API with the connection string and the
#       signing key delivered ONLY as files: the container reports healthy, the
#       readiness probe reaches the database, a sign-in returns a usable token, and
#       `docker inspect` shows neither value in the environment.
#     * PERMISSIONS MATTER, AND THE FAILURE IS LOUD. The API process runs as the
#       unprivileged uid 1000 account the image creates, so each mounted file must
#       be READABLE by it - mode 0444 is the usual choice, and it is what compose
#       and Kubernetes produce by default. A root-only file is not silently ignored:
#       the host fails to start, which is the correct direction but arrives as a
#       permission error rather than as a message about a missing setting.
#     * A MANAGED SECRET STORE - Azure Key Vault, AWS Secrets Manager, HashiCorp
#       Vault - is reached either by the orchestrator writing the fetched material
#       into the mounted directory above, or by an entry-point exporting it into the
#       environment. NEITHER of those needs a code change. A store read directly by
#       the application through its own configuration provider WOULD need one: that
#       provider is not registered here, and this template no longer implies it is.
#   Any of these routes is a DELIBERATE DEVIATION from the preserved compose example
#   and belongs in MIGRATION_NOTES.md when taken, alongside the deviations already
#   recorded there.
# =============================================================================


# -----------------------------------------------------------------------------
# DB_CONNECTION_STRING                                            *** REQUIRED ***
#
#   Type      SQL Server connection string
#   Maps to   ConnectionStrings__Default -> configuration key ConnectionStrings:Default
#             (`__` is .NET's separator for `:`; a single underscore binds to nothing)
#   Default   NONE. appsettings.json ships an empty value and the Production
#             overlay supplies none
#   Secret    YES - it carries a password. Prefer a secret store over this file
# -----------------------------------------------------------------------------
# The API validates this at start-up and REFUSES TO START on a value that is
# blank, unparseable, names no server, names no database, names no way to
# authenticate, or still carries a documented placeholder. The refusal names the
# rule and never echoes any part of the value. That strictness is deliberate: the
# `/health` liveness probe excludes the database on purpose, so a container with a
# broken connection string would otherwise report HEALTHY, release the front end
# behind it, and fail every database-backed request and every sign-in.
#
# CERTIFICATE VALIDATION IS THE POINT OF THIS SHAPE. Microsoft.Data.SqlClient has
# defaulted to `Encrypt=True` since 4.0, so the driver always negotiates TLS; what
# `TrustServerCertificate=True` adds is the silent DISABLING of the validation that
# makes the encryption worth having. The examples below therefore omit it, and
# expect a certificate the client already trusts (install the SQL Server
# certificate's issuer into the container's trust store, or issue the server a
# certificate from an authority already in it).
#
# `host.docker.internal` is the container's route back to the machine running
# Docker; the compose file maps it to host-gateway so the name also resolves on
# Linux. Never write `localhost` here - inside a container that is the container.
#
# DO NOT ADD `MultipleActiveResultSets=True`. It is a common addition to a legacy
# DotNetNuke connection string, it looks harmless, and the damage is silent:
# Microsoft.Data.SqlClient cannot take a transaction savepoint on a MARS
# connection, so EF Core proceeds without one and logs
# `SavepointsDisabledBecauseOfMARS` and nothing else. This API has multi-step
# SERIALIZABLE transactions that depend on savepoints - tenant removal deletes a
# tenant's modules before the tenant itself, because that foreign key is the one
# in this schema with no cascade - and without them a failure part-way through
# cannot be unwound to a known point. The keyword buys this API nothing: EF Core
# reads each query to completion and every I/O path is awaited.
#
# Shapes to copy into the active line below. Replace <sql-login> and
# <sql-password> with a real credential, which belongs in a secret store:
#   SQL Server on the Docker host:
#     DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DotNetNuke;User Id=<sql-login>;Password=<sql-password>;Encrypt=True
#   SQL Server on a named host:
#     DB_CONNECTION_STRING=Server=sqlserver.example.com,1433;Database=DotNetNuke;User Id=<sql-login>;Password=<sql-password>;Encrypt=True
#   SQL Server as another container on the same network:
#     DB_CONNECTION_STRING=Server=sqlserver,1433;Database=DotNetNuke;User Id=<sql-login>;Password=<sql-password>;Encrypt=True
#   LOCAL DEVELOPMENT ONLY - a self-signed server certificate, validation disabled.
#   Never deploy this shape:
#     DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DotNetNuke;User Id=<sql-login>;Password=<sql-password>;TrustServerCertificate=True;Encrypt=True
#
# Windows account authentication is NOT USABLE from this container: the legacy
# `Data Source` form relied on a per-account Express instance, a database file
# attached at run time and Windows authentication, none of which exist in the
# Linux Alpine image the API runs in. Use SQL authentication, or an identity
# mechanism supported on Linux.
#
# The value below is EMPTY on purpose, so an unedited copy fails loudly at
# start-up rather than quietly at the first query.
DB_CONNECTION_STRING=


# -----------------------------------------------------------------------------
# JWT_SECRET                                                      *** REQUIRED ***
#
#   Type      symmetric signing key, at least 32 UTF-8 bytes
#   Maps to   Jwt__Secret -> configuration key Jwt:Secret
#   Default   NONE. appsettings.json ships an empty value and no overlay supplies one
#   Secret    YES - it signs and verifies every access token
# -----------------------------------------------------------------------------
# Start-up enforces all three of these before the API serves traffic:
#   * at least 32 UTF-8 BYTES - 256 bits, the output width of the SHA-256 that
#     HMAC-SHA256 is built on, so a shorter key adds no strength the algorithm
#     can use;
#   * at least 8 distinct characters, which rejects a long run of one character
#     that satisfies the length rule with almost no entropy;
#   * no well-known placeholder fragment, matched case-insensitively.
#
# The value below trips that third rule ON PURPOSE: a deployment that forgets to
# replace it fails at start-up rather than signing real tokens with a key
# published in this repository.
#
# Generate a fresh key per environment from a cryptographic random source and hold
# it in a managed secret store rather than in this file:
#       openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_KEY_OF_AT_LEAST_32_BYTES


# -----------------------------------------------------------------------------
# WITHDRAWN: TLS_CERTIFICATE_PATH / TLS_PRIVATE_KEY_PATH
# -----------------------------------------------------------------------------
# These two variables were shipped here marked *** REQUIRED *** and NOTHING
# CONSUMED THEM. Neither compose file, neither Dockerfile and no nginx
# configuration in this repository referenced either name, and the secret mounts
# their description claimed - /run/secrets/tls_certificate and
# /run/secrets/tls_private_key - do not exist in any delivered artefact either.
# An operator following this template therefore supplied two inert absolute paths
# and could omit the ONE variable the TLS overlay genuinely reads.
#
# The certificate contract is a DIRECTORY, not a pair of file paths, because
# docker/docker-compose.tls.yml mounts `${TLS_CERTIFICATE_DIRECTORY}` read-only
# into the front-end container and the TLS server block rendered from
# docker/nginx.tls.conf.template reads fullchain.pem and privkey.pem from inside
# it. That one variable is documented in its own section below, and it is the only
# certificate setting this repository has ever consumed.
#
# This note is deliberately left in place rather than deleted silently: an
# operator upgrading from an earlier copy of this template has those two lines in
# a live .env file and needs to be told they never did anything.


# -----------------------------------------------------------------------------
# Optional overrides
#
# Compose supplies a fallback for each of these, so they ship COMMENTED OUT: an
# entry left accidentally blank would shadow a perfectly good default. Uncomment
# only what a deployment genuinely has to change, and give it a value when you do.
# -----------------------------------------------------------------------------

# JWT_ISSUER -> Jwt__Issuer -> Jwt:Issuer. Written to the `iss` claim of every
# token issued and checked on every token presented, so a blank value disables
# that check rather than passing it. Compose fallback: DnnMigration.
#JWT_ISSUER=DnnMigration

# JWT_AUDIENCE -> Jwt__Audience -> Jwt:Audience. Written to `aud` and checked the
# same way. Compose fallback: DnnMigration. Issuer and audience hold the same
# string deliberately: this API is a backend-for-frontend with exactly one client,
# so it is the only audience for the tokens it issues. A deployment fronting
# further clients would separate the two.
#JWT_AUDIENCE=DnnMigration

# JWT_EXPIRATION_MINUTES -> Jwt__ExpirationMinutes -> Jwt:ExpirationMinutes.
# Access-token lifetime in minutes; a positive whole number. Compose fallback: 60,
# which preserves the legacy authentication ticket timeout exactly. Lowering it
# narrows the window in which a leaked token stays usable, at the cost of more
# traffic on the refresh endpoint.
#JWT_EXPIRATION_MINUTES=60

# REFRESH_TOKEN_STORE_PROVIDER -> `RefreshTokenStore__Provider` ->
# RefreshTokenStore:Provider. Declares WHICH refresh-token store this deployment
# runs, and the accepted names are a closed set - an unrecognised name stops the
# container rather than falling back to the default. Compose fallback: InProcess.
#
#   InProcess   the process-local store this image ships, and the default.
#               `InMemory` is accepted as an alias of it, which is what a
#               deployment written against an earlier revision may declare.
#   SqlServer   the shared, durable store this repository also ships. Refresh
#               families then survive a restart and every replica observes the
#               same revocations. It needs REFRESH_TOKEN_STORE_CONNECTION, and
#               that catalogue MUST NOT be the DotNetNuke database - see the
#               section on that variable further down.
#   External    a store the DEPLOYMENT registers itself. It enables nothing; it
#               ASSERTS that an IRefreshTokenStore other than this repository's
#               has been registered after AddInfrastructure (the last
#               registration of a service wins), and the API verifies the
#               assertion while it starts. Against THIS image it correctly stops
#               the container, because no replacement is registered in it.
#
# LEFT AT InProcess, REFRESH STATE IS PROCESS-LOCAL: it lives in the API process,
# so it is neither shared between replicas nor carried across a restart, which is
# why the compose file publishes a single api service. A revocation that cannot be
# confirmed is reported as UNCONFIRMED rather than as a completed sign-out, so no
# session is ever silently left live - the client keeps its credential and retries.
# The `refresh-token-store` health probe reports the mode, whether it is
# replica-safe and whether it survives a restart. See the operating notes in
# README.md.
#REFRESH_TOKEN_STORE_PROVIDER=InProcess

# REFRESH_TOKEN_STORE_SINGLE_INSTANCE ->
# `RefreshTokenStore__AcknowledgeSingleInstance` ->
# RefreshTokenStore:AcknowledgeSingleInstance. Compose fallback: true, because the
# compose file starts exactly one api service.
#
# IN PRODUCTION THE API REFUSES TO START on a session store that is neither shared
# between replicas nor carried across a restart unless the deployment states that it
# runs a single instance. That is this variable. Scaling the API out on the
# process-local store needs no code change and no configuration change and produces
# no warning, while a sign-out performed against one replica leaves the session
# exchangeable on every other and a restart forgets every family it issued - both of
# which present as intermittent session behaviour that no log explains. The
# limitation was previously recorded in prose only, which nobody reads at the moment
# they add a replica.
#
# IT CHANGES NO BEHAVIOUR and grants no capability. Its only function is to make the
# claim explicit, so a later scale-out is a decision to revisit rather than a silent
# regression. Set it ONLY where a single instance is genuinely enforced by the
# topology.
#
# If you run more than one instance, do not set this: set
# REFRESH_TOKEN_STORE_PROVIDER=SqlServer with a session catalogue instead. A shared
# store satisfies the requirement on its own merits and the acknowledgement becomes
# irrelevant. Non-production environments are unaffected either way, deliberately -
# an acknowledgement demanded everywhere is one that gets set reflexively and stops
# meaning anything.
#REFRESH_TOKEN_STORE_SINGLE_INSTANCE=true

# REFRESH_TOKEN_MAX_TRACKED -> `RefreshTokenStore__MaximumTrackedTokens` ->
# RefreshTokenStore:MaximumTrackedTokens. How many refresh-token generations the
# in-process store tracks at once; must be between 1000 and 1000000, and the API
# refuses to start outside that range. Compose fallback: 100000, which is roughly
# ten megabytes of tracked state and far above any ordinary working set - one
# caller refreshing every half hour for a full thirty-day family lifetime accounts
# for about 1,400 generations. At the ceiling the OLDEST refresh families are
# retired first, so their holders sign in again while every request continues to be
# served, and the `refresh-token-store` health probe reports Degraded with the
# usage. Raise it only if that probe says you need to; past a million the honest
# answer is a shared store rather than a larger per-replica dictionary.
#REFRESH_TOKEN_MAX_TRACKED=100000

# REFRESH_TOKEN_GRACE_SECONDS -> `RefreshTokenStore__ConcurrentUseGraceSeconds` ->
# RefreshTokenStore:ConcurrentUseGraceSeconds. The window, in seconds, in which a
# refresh token already spent may be presented AGAIN by the same client without
# being treated as theft; 0 to 60, Compose fallback 5. It exists because an
# interrupted exchange - a dropped response, a retried request - would otherwise
# revoke the caller's whole token family. Zero is the strictest setting and treats
# every reuse as a replay; a long window weakens replay detection, which is why 60
# is the ceiling.
#REFRESH_TOKEN_GRACE_SECONDS=5

# FRONTEND_ORIGIN -> `Cors__AllowedOrigins__0` -> Cors:AllowedOrigins[0]. The one
# exact browser origin allowed to call the API cross-origin; the trailing `__0`
# is .NET's spelling for the first element of an array setting. Give a scheme,
# host and port with no trailing slash and no path. Compose fallback:
# http://localhost:4200, the port the base compose file publishes the SPA on. A
# wildcard is never acceptable here: the API has no legitimate browser caller it
# cannot name, and the policy deliberately never enables ambient browser
# credentials.
#
# READ BY THE BASE TOPOLOGY ONLY. The containerised SPA is same-origin through the
# proxy and needs no cross-origin permission at all, so this entry exists for a
# workstation running the SPA's own dev server against the container. The TLS
# overlay does NOT read it: it derives the permitted origin from DNN_PUBLIC_HOST
# instead, because two variables that must agree are two variables that can
# disagree - and that is exactly how a deployment came to have a correct origin
# alongside a host filter and a server_name that still named the template's
# example. One public identity, four consumers.
#
# A host name reserved for documentation is REFUSED here at start-up: an origin on
# example.com, example.net, example.org or the .example top-level domain can never
# be sent by a browser, so a policy configured with one would admit nothing while
# looking configured. Names a private deployment legitimately uses - .test,
# .invalid, .localhost, localhost, an address literal - are accepted.
#FRONTEND_ORIGIN=http://localhost:4200


# -----------------------------------------------------------------------------
# DNN_PUBLIC_HOST
#            *** REQUIRED when the TLS overlay is used; unused otherwise ***
#
# THE ONE PUBLIC IDENTITY OF A DEPLOYMENT, AND THE SETTING THAT ENDED AN IMPLICIT
# SOURCE EDIT. It is shipped commented out because it is meaningless without the
# overlay; the overlay itself has NO fallback for it, so compose refuses to create
# a container until it is set.
# -----------------------------------------------------------------------------
# Read ONLY by docker/docker-compose.tls.yml, which passes it to FOUR consumers
# that must agree with one another:
#
#   1. the reverse proxy's two `server_name` directives, rendered into
#      docker/nginx.tls.conf.template by the nginx image's own entrypoint - which
#      is what decides whose port-80 requests are redirected to HTTPS;
#   2. the API's `AllowedHosts`, as `${DNN_PUBLIC_HOST};localhost;127.0.0.1` - the
#      loopback entries stay so the container health probe keeps working;
#   3. the API's permitted browser origin, as `https://${DNN_PUBLIC_HOST}`;
#   4. the certificate TLS_CERTIFICATE_DIRECTORY must contain, which has to be
#      valid for this name.
#
# WHY IT EXISTS. Consumers 1 and 2 were literals in tracked files - the API's host
# filter read `dnn.example.com;localhost;127.0.0.1` and both server names read
# `dnn.example.com` - while only consumer 3 read a variable. A deployment that
# followed the documented workflow and set its origin therefore ran with a redirect
# scoped to a name its browsers never send, a certificate matching no server name,
# and a host filter answering 400 to all of its own traffic. Avoiding that meant
# editing tracked source, which is a fork rather than a deployment.
#
# GIVE A BARE HOST NAME: no scheme, no port, no path, no trailing dot - for
# example `admin.acme.test`. Add a port only if the deployment publishes 443
# somewhere other than 443, in which case the port belongs in the browser origin
# rather than here.
#
# THE VALUE BELOW IS DELIBERATELY ONE THE API REFUSES TO START ON. `.example` is
# reserved for documentation by RFC 6761, and the API rejects it - along with
# example.com, example.net, example.org and unreplaced markers such as `changeme`
# - precisely so that copying this template's illustration fails closed at
# start-up instead of serving traffic under a name nothing else agrees on.
# Reserved TEST domains are NOT refused: `.test`, `.invalid` and `.localhost` are
# what a private deployment or an internal certificate authority legitimately uses.
#DNN_PUBLIC_HOST=admin.acme.example


# -----------------------------------------------------------------------------
# TLS_CERTIFICATE_DIRECTORY
#            *** REQUIRED when the TLS overlay is used; unused otherwise ***
#
# THE ONE AND ONLY CERTIFICATE CONTRACT IN THIS REPOSITORY. It replaces the
# withdrawn TLS_CERTIFICATE_PATH / TLS_PRIVATE_KEY_PATH pair above, which nothing
# consumed. It is shipped commented out because it is meaningless without the
# overlay; the overlay has NO fallback for it, so compose refuses to create a
# container until it is set. It previously defaulted to ./certificates, which made
# a forgotten setting surface as nginx failing to start for want of a certificate
# rather than as the missing setting that caused it.
# -----------------------------------------------------------------------------
# Read ONLY by docker/docker-compose.tls.yml, the overlay that terminates TLS at
# the front end, withdraws the API's published port and switches forwarded-header
# trust on. Both required variables are supplied on one command line, and NO
# tracked file is edited:
#
#   DNN_PUBLIC_HOST=admin.acme.test \
#   TLS_CERTIFICATE_DIRECTORY=/etc/letsencrypt/live/admin.acme.test \
#   docker compose -f docker/docker-compose.yml \
#                  -f docker/docker-compose.tls.yml \
#                  --env-file docker/.env up -d
#
# Point it at a host directory holding exactly two files:
#     fullchain.pem   the server certificate and its issuing chain
#     privkey.pem     the matching private key
# Both are mounted read-only, at /etc/nginx/tls/certificates - a directory the
# proxy's own `*.conf` include glob cannot match, so a mounted certificate can
# never be parsed as configuration. Keep the private key out of this repository
# and out of any image: it is mounted at run time and nothing copies it.
#
# THE CERTIFICATE MUST BE VALID FOR DNN_PUBLIC_HOST. That is the same name the
# proxy's server_name and the API's host filter are rendered from, so a mismatch
# is a certificate problem only - never a configuration disagreement between the
# three.
#
# *** THE KEY PAIR MUST BE READABLE BY UID 101, AND A DEFAULT-PERMISSIONED KEY IS
# *** NOT. SEC-12.
#
# The proxy container now runs UNPRIVILEGED - as uid 101, the image's own nginx
# account - instead of as a root master that dropped to a worker account. The
# private key is therefore opened by uid 101, and a key that is root-owned and
# mode 0600 (what certbot and openssl produce by default, and what worked while
# the master was root) cannot be opened at all. nginx refuses to start and says
# so like this:
#
#     [emerg] cannot load certificate key
#     "/etc/nginx/tls/certificates/privkey.pem": BIO_new_file() failed
#     (SSL: ... Permission denied ... calling fopen(...))
#
# Grant read access to uid 101 - and grant no more than that:
#
#     chown 101:101 <dir>/fullchain.pem <dir>/privkey.pem
#     chmod 640     <dir>/privkey.pem      # 644 on fullchain.pem is fine; it is public
#
# Or, where the host manages certificates centrally and the files must keep their
# owner, add uid 101 to a group the key already grants read to. Do NOT make the
# key world-readable to get past this: the whole point of the change is that fewer
# things can read it, and 0644 on a private key is a larger exposure than the root
# master ever was. Both outcomes above were measured against this image - the
# root-owned 0600 pair failed exactly as quoted, and the same container served
# HTTPS on 443 once the pair was readable by 101.
#
# A LET'S ENCRYPT DIRECTORY NEEDS ONE EXTRA STEP: the live path holds symlinks
# into ../../archive, so the ownership has to be applied to the archive files the
# links resolve to, and re-applied after each renewal - a renewal hook is the
# usual place for it.
#TLS_CERTIFICATE_DIRECTORY=/etc/letsencrypt/live/admin.acme.example


# -----------------------------------------------------------------------------
# TLS_ALLOWED_HOSTS
#            *** WITHDRAWN - NOTHING READS IT. Set DNN_PUBLIC_HOST instead ***
#
#   Type      semicolon-separated list of host names
#   Maps to   nothing. The overlay derives AllowedHosts from DNN_PUBLIC_HOST
#   Default   none
#   Secret    no
# -----------------------------------------------------------------------------
# The host names this API answers on. ASP.NET Core's host filter rejects a request
# whose Host header is not one of them before any endpoint sees it, so a deployment
# that follows the TLS instructions and forgets this gets a valid certificate, two
# healthy containers, and every request refused - a failure with nothing in it that
# points at host filtering.
#
# THIS VARIABLE IS NO LONGER CONSUMED, and the note is kept rather than deleted
# because a deployment upgrading from an earlier revision has an inert line in a
# live .env file and needs to be told so. The overlay now composes the filter from
# DNN_PUBLIC_HOST - `${DNN_PUBLIC_HOST};localhost;127.0.0.1` - which is what
# removed the example.com default this section used to ship, and which keeps the
# two loopback entries the container health probe needs: it addresses the API on
# the loopback address, so dropping them would make the api service permanently
# unhealthy and the front end would never start. One public identity, four
# consumers; two variables that must agree are two variables that can disagree.
#
# The base (plain-HTTP) topology sets no filter at all: appsettings.json ships
# `AllowedHosts: "*"`, which is correct for a loopback-published validation
# topology and is exactly what the overlay narrows.


# -----------------------------------------------------------------------------
# TRUSTED_PROXY_ADDRESS                                            *** OPTIONAL ***
#
#   Type      one IP address
#   Maps to   Proxy__KnownProxies__0 -> Proxy:KnownProxies[0]
#   Default   172.28.0.10 - the fixed compose address of the frontend (nginx) container
#   Secret    no
# -----------------------------------------------------------------------------
# The ONE reverse-proxy address permitted to report the original client's address
# and scheme through X-Forwarded-For and X-Forwarded-Proto.
#
# WHY IT MATTERS. The API's credential rate limiter partitions on the caller's
# address. With no trusted proxy the framework's default trust - loopback only -
# applies, so inside a container the forwarded headers are ignored and the address
# the limiter observes is the reverse proxy's for every browser in the deployment.
# All callers then share ONE credential budget and any single client can exhaust
# everybody else's.
#
# GIVE ONE ADDRESS, NOT A RANGE. A forwarded address is supplied by whoever made
# the request, so trusting a hop you do not operate lets a caller name its own
# address and therefore choose its own rate-limit partition. Trusting the compose
# subnet is NOT equivalent and is not safe here: the api service publishes 8080 on
# the host, and a request arriving through that published port is source-translated
# to the network gateway, which is itself a subnet address - so a direct caller on
# the host would be trusted.
#
# Override it only if you have changed that address or you front the API with a
# different proxy. A deployment that terminates TLS and rate-limits AT the proxy can
# set this to an address nothing uses, in which case the API's own limiter degrades
# to one shared budget - more restrictive, and acceptable only when something else
# is doing the per-caller accounting.
#
# Only the forwarded ADDRESS and SCHEME are honoured. The forwarded HOST is not:
# this API resolves the tenant from the host name, so accepting a forwarded host
# would let a caller behind a trusted proxy choose which tenant it is served.
#TRUSTED_PROXY_ADDRESS=172.28.0.10


# -----------------------------------------------------------------------------
# LEGACY_CREDENTIALS_*                                             *** OPTIONAL ***
#
#   Type      switch, absolute UTC instant, hexadecimal key
#   Maps to   LegacyCredentials__Enabled / __EnabledUntilUtc / __DecryptionKey
#   Default   Enabled=false with empty companions - the normal post-migration state
#   Secret    the DECRYPTION KEY is, absolutely
# -----------------------------------------------------------------------------
# Existing DotNetNuke accounts may still hold a credential in the membership
# provider's legacy clear, SHA-1 or machine-key-encrypted format. The API can verify
# such a value ONCE and replace it immediately with BCrypt, but the compatibility
# path is OFF by default and expires at one absolute UTC instant.
#
# Enable all three together:
#   LEGACY_CREDENTIALS_ENABLED=true
#   LEGACY_CREDENTIALS_ENABLED_UNTIL_UTC=YYYY-MM-DDTHH:MM:SSZ
#   LEGACY_CREDENTIALS_DECRYPTION_KEY=<READ_FROM_SECRET_STORE>
#
# The key is the legacy machine-key decryption value, supplied at deployment time
# from a managed secret store. NEVER paste it into this tracked template, into
# appsettings.json, into a committed compose override, into a log, or into a support
# ticket. Start-up validates its length, its hexadecimal alphabet and its Triple-DES
# strength, and never includes the value in an error.
#
# The deadline is ABSOLUTE rather than relative to process start, so restarting the
# container cannot renew the window, and start-up refuses an enabled window with no
# deadline or a non-UTC one. Once it passes, accounts that have not signed in use the
# administrator-reset path. Leaving all three unset is the normal configuration:
# compose passes Enabled=false with empty companions, start-up accepts that disabled
# shape, and the verifier fails closed. MIGRATION_NOTES.md Section 4.1 is the full
# account.
#LEGACY_CREDENTIALS_ENABLED=false
#LEGACY_CREDENTIALS_ENABLED_UNTIL_UTC=YYYY-MM-DDTHH:MM:SSZ
#LEGACY_CREDENTIALS_DECRYPTION_KEY=READ_FROM_SECRET_STORE


# -----------------------------------------------------------------------------
# WITHDRAWN: TLS_CERTIFICATE_PATH / TLS_PRIVATE_KEY_PATH
# -----------------------------------------------------------------------------
# An earlier copy of this template shipped these two marked *** REQUIRED *** and
# nothing consumed them - no compose file, no Dockerfile and no nginx configuration
# referenced either name. The certificate contract is a DIRECTORY, documented above
# as TLS_CERTIFICATE_DIRECTORY. This note is kept rather than deleted silently
# because an operator upgrading from that copy has two inert lines in a live .env
# file and needs to be told so.


# -----------------------------------------------------------------------------
# Not variables - settings that are fixed in the compose files
#
# Listed so their absence from this template is not read as an omission. Each is
# stated as the compose files currently declare it; change it there, not here.
# -----------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT is hard-coded to Production on the api service in
#   docker-compose.yml and is not interpolated.
# The Kestrel listen address is baked into the image as ASPNETCORE_URLS=http://+:8080
#   by docker/api.Dockerfile. docker-compose.yml deliberately does not restate it.
# Published ports are fixed by the compose files: the API on 127.0.0.1:8080:8080 -
#   LOOPBACK ONLY, so its cleartext listener is not reachable off this host - and the
#   SPA on 4200:80. The TLS overlay withdraws the API's published port entirely and
#   publishes 80 and 443 for the front end.
# Https__RedirectEnabled is set explicitly in BOTH compose files: false in
#   docker-compose.yml, because appsettings.Production.json enables redirection and
#   every non-health path would otherwise be answered with a redirect this cleartext
#   topology cannot satisfy; true in docker-compose.tls.yml, together with
#   Https__RedirectPort=443.
# AllowedHosts is set only by the TLS overlay, from DNN_PUBLIC_HOST above. The base
#   topology inherits `*` from appsettings.json.
# Proxy__KnownProxies__0 IS interpolated, from TRUSTED_PROXY_ADDRESS above, and it
#   defaults to the front end's fixed compose address - so the base topology trusts
#   exactly one hop rather than nothing. Proxy__KnownNetworks is not set anywhere:
#   trusting a range would also trust the gateway that host traffic to the published
#   API port is translated to.
# The SPA's API base address is not a run-time value at all. It is baked into the
#   Angular bundle at build time as the RELATIVE path /api/v1, which nginx proxies to
#   the api service, so the browser always calls the origin that served it.
# Database credentials arrive only inside DB_CONNECTION_STRING. There are
#   deliberately no separate account, password or server variables, and no database
#   administrator password, because this topology starts no database container.
# Nothing here configures a cache, a message broker, a mail server or a telemetry
#   endpoint; the API uses none of them.
# No legacy DotNetNuke setting appears here. The provider attributes that qualified
#   legacy object names have no counterpart - table and schema names are fixed in the
#   Infrastructure layer's entity configurations - and the machine-level keys the
#   legacy configuration committed are covered by JWT_SECRET and, for the bounded
#   migration window only, LEGACY_CREDENTIALS_DECRYPTION_KEY.

# ---------------------------------------------------------------------------
# REFRESH_TOKEN_STORE_CONNECTION                                    (optional)
# ---------------------------------------------------------------------------
# The catalogue holding the SHARED refresh-token store's single table. Compose
# passes it in as `RefreshTokenStore__ConnectionString`, and it is read only when
# REFRESH_TOKEN_STORE_PROVIDER (above) selects SqlServer.
#
# Set the provider to SqlServer and supply a connection string to make refresh
# families durable and shared.
#
# THE CATALOGUE MUST NOT BE THE DOTNETNUKE DATABASE, and the API enforces it at
# start-up rather than trusting the operator. Three rules are applied, and all three
# refuse the host outright: the connection string must name its catalogue explicitly
# through `Database=` or `Initial Catalog=`; that catalogue must not be one of the
# server's own administrative databases (master, model, msdb, tempdb); and its NAME
# must differ from the catalogue named by DB_CONNECTION_STRING. The comparison is by
# catalogue name rather than by whole connection string on purpose - a host is
# spellable as localhost, 127.0.0.1, (local), a machine name or a named instance,
# so a rule that compared hosts could be bypassed by writing one differently.
# Give the session catalogue a distinct name and the rules never trouble you.
#
# PROVISION THE TABLE BEFORE STARTING THE API. It is created by a deployment step,
# not by the running application, which neither creates nor alters it: create the
# catalogue and then run docker/sql/refresh-token-store.sql against it. The API
# probes for the table on first use and reports session operations as unavailable -
# and says so on its health endpoint - while it is absent. A configuration that
# still sets RefreshTokenStore__CreateTableIfMissing is REFUSED at start-up with a
# message naming that script: the setting existed in an earlier build and let the
# API create its own table, which is schema authorship at runtime by the process
# that serves requests.
#
# USE A PRINCIPAL THAT CANNOT DO MORE THAN THE STORE NEEDS. Do not reuse `sa`, and
# do not reuse the principal that ran the provisioning script. The API needs exactly
# four rights on exactly one table:
#
#   CREATE USER [dnnmigration_api] FOR LOGIN [dnnmigration_api];
#   GRANT SELECT, INSERT, UPDATE, DELETE
#     ON [dbo].[DnnMigrationRefreshTokens] TO [dnnmigration_api];
#
# ENCRYPT THE CONNECTION AND VALIDATE THE CERTIFICATE. `Encrypt=True` is required:
# refresh-token digests and the session's account and tenant identifiers cross this
# connection. Leave `TrustServerCertificate` OUT so the server's certificate is
# verified against a trust chain - a trusted certificate is what makes the
# encryption resistant to interception rather than merely present.
#
#   REFRESH_TOKEN_STORE_PROVIDER=SqlServer
#   REFRESH_TOKEN_STORE_CONNECTION=Server=sql,1433;Database=DnnMigrationSessions;User Id=dnnmigration_api;Password=<password>;Encrypt=True
#
# TrustServerCertificate=True disables that verification, so it belongs ONLY on a
# developer machine talking to a local container with a self-signed certificate.
# Never set it in a deployment where the database is reached over a network you do
# not wholly control:
#
#   # local development ONLY - accepts any certificate the server presents
#   REFRESH_TOKEN_STORE_CONNECTION=Server=localhost,1433;Database=DnnMigrationSessions;User Id=dnnmigration_api;Password=<password>;Encrypt=True;TrustServerCertificate=True
