# =============================================================================
# TLS termination for the DnnMigration front end - A TEMPLATE, RENDERED AT
# CONTAINER START FROM THE DEPLOYMENT'S OWN PUBLIC HOST NAME.
#
# WHAT THIS FILE IS. A drop-in pair of `server` blocks that docker/nginx.conf loads
# through `include /etc/nginx/tls/*.conf;`. It is NOT copied into the image:
# mounting it is what activates TLS, so an image build and a plain-HTTP deployment
# are unaffected by its existence. docker/docker-compose.tls.yml mounts it,
# publishes 443 and withdraws the API's published port.
#
#   DNN_PUBLIC_HOST=admin.acme.example TLS_CERTIFICATE_DIRECTORY=/etc/letsencrypt/live/admin.acme.example \
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.tls.yml \
#       --env-file docker/.env up -d
#
# WHY IT IS A TEMPLATE. Both server names come from one environment variable, so a
# deployment names itself once and edits no tracked file. A hard-coded server name
# would give a deployment a port-80 redirect scoped to a name no browser sends - so
# its own callers could be served the application over cleartext - a TLS server whose
# name did not match its certificate, and an API that refused its traffic by host
# filtering, with a source edit as the only way out.
#
#   ${DNN_PUBLIC_HOST} below is substituted by the nginx image's OWN entrypoint.
#   /docker-entrypoint.d/20-envsubst-on-templates.sh renders every
#   /etc/nginx/templates/*.template into $NGINX_ENVSUBST_OUTPUT_DIR, which the
#   overlay points at /etc/nginx/tls - the directory docker/nginx.conf already
#   scans - before nginx is executed. The overlay also sets
#   NGINX_ENVSUBST_FILTER=^DNN_, which confines substitution to names beginning
#   DNN_: without it, envsubst would be handed every environment variable and could
#   substitute an nginx variable that happened to share a name.
#
#   ONE INPUT, FOUR CONSUMERS. The same DNN_PUBLIC_HOST drives the two server names
#   here, the API's AllowedHosts, the API's cross-origin allow-list and the
#   certificate the deployment is expected to supply for that name. Compose refuses
#   to create a container when it is unset or blank, and the API refuses to START on
#   a reserved example domain, so a placeholder deployment fails closed at the
#   perimeter rather than serving traffic under a name nothing agrees on.
#
# WHY IT IS NOT PART OF nginx.conf. A `listen 443 ssl` whose certificate is not on
# disk makes nginx fail to start, so writing it inline would take the whole front
# end down on every deployment that has not yet obtained a certificate - a
# hardening measure that produces an outage. A wildcard include that matches
# nothing is not an error, which is what makes TLS a mount rather than an edit.
#
# WHAT IT EXPECTS. Two files, mounted read-only:
#     /etc/nginx/tls/certificates/fullchain.pem   server certificate + chain
#     /etc/nginx/tls/certificates/privkey.pem     matching private key
# valid for ${DNN_PUBLIC_HOST}. Both paths are deliberately outside
# /etc/nginx/tls/*.conf's own glob, so mounting the certificates cannot accidentally
# be parsed as configuration - and outside the rendered file's own name, so the
# entrypoint cannot overwrite them.
#
# HOW IT SERVES THE APPLICATION: BY INCLUDING THE SAME THREE SNIPPETS THE
# PLAIN-HTTP SERVER INCLUDES. An nginx server block inherits from http but not from
# a sibling server, so this block has to declare the application's locations
# itself. It includes /etc/nginx/snippets/{security-headers,api-proxy,spa-static}.conf
# rather than restating them, so "identical to the plain-HTTP server" is a property of
# the configuration rather than a claim in a comment - which is what keeps
# per-request upstream resolution, the raw request target, the import-sized body
# allowance, the RFC 7807 gateway answer and every response security header on this
# listener too.
#
# WHAT IT DOES TO PLAIN HTTP. The default server in docker/nginx.conf keeps
# listening on 80 and keeps serving, because the container health probe and any
# internal caller address it there. Browser traffic for THIS deployment's own name
# is moved to TLS by the redirect below; a request whose Host does not match falls
# through to that default server, so the health probe is never redirected.
#
# WHAT IT DOES NOT DO. It does not terminate TLS for the API. The API speaks plain
# HTTP on the internal network by design (docker/api.Dockerfile sets
# ASPNETCORE_URLS=http://+:8080) and this proxy forwards X-Forwarded-Proto, which
# the API's pipeline honours only from a proxy address the deployment has named in
# Proxy:KnownProxies or Proxy:KnownNetworks.
# =============================================================================

# ---- Plain HTTP for this server name: redirect to TLS -----------------------
# Scoped by server_name, so it applies to browser traffic for this deployment and
# to nothing else. The container health probe addresses the loopback address and
# therefore matches the default server, not this one.
server {
    listen      80;
    listen      [::]:80;

    server_name ${DNN_PUBLIC_HOST};

    # The response policy applies to a redirect too. It costs nothing and it means
    # no response this topology emits is unpoliced.
    include /etc/nginx/snippets/security-headers.conf;

    # 307, and NOT 301 or 308.
    #
    # MIGRATION: this line read 308, on the stated ground that it preserves the method
    #   and the body so a POST arriving over plain HTTP is re-issued as a POST over TLS
    #   rather than silently downgraded to a GET. That goal is real and 307 meets it
    #   just as fully - both codes preserve both - so the cacheability argument decides
    #   it: a permanent redirect is cached by the browser and by every intermediary on
    #   the path, so a deployment that has to answer over plain HTTP again during a
    #   certificate replacement stays unreachable for callers holding the cached
    #   answer. The permanence a deployment does want is expressed by strict transport
    #   security, which carries a bounded lifetime.
    #
    #   $host rather than $http_host is kept: this server answers on the default HTTP
    #   port in the topology docker-compose.tls.yml publishes, so the two resolve
    #   identically here, and carrying an HTTP port into an HTTPS target would name a
    #   port nothing listens on.
    return 307 https://$host$request_uri;
}

# ---- TLS ---------------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;

    # The same name the certificate is issued for, and the same name the API admits
    # through AllowedHosts. All three come from DNN_PUBLIC_HOST.
    server_name ${DNN_PUBLIC_HOST};

    ssl_certificate     /etc/nginx/tls/certificates/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/certificates/privkey.pem;

    # TLS 1.2 is retained for client compatibility; everything below it is refused.
    # The cipher list is the modern-plus-intermediate intersection: forward secrecy
    # only, authenticated encryption only, no static RSA key exchange, no CBC.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache         shared:DnnMigrationTls:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Where docker/frontend.Dockerfile placed the production build output. The
    # snippet below decides how it is served.
    root  /usr/share/nginx/html;
    index index.html;

    # The response policy, from the file that declares it once. $hsts_policy is
    # keyed on $scheme in docker/nginx.conf, and $scheme is "https" in a
    # `listen 443 ssl` server, so strict transport security is emitted here and
    # omitted on the plain-HTTP default server with no second knob anywhere.
    #
    # ⚠ THE HEADER VALUES ARE DEFINED ONCE AND INCLUDED HERE, never written again in
    #   this block. Two hand-maintained copies drift - a lost `usb=()` in
    #   Permissions-Policy, a `preload` token that nginx.conf deliberately omits
    #   because a browser preload entry is irreversible on any useful timescale and
    #   binds every subdomain, or a `$csp` variable that does not exist and makes nginx
    #   REFUSE TO START and restart in a loop the moment TLS is activated. One
    #   definition with several include sites makes that class of failure impossible.
    include /etc/nginx/snippets/security-headers.conf;

    # The API reverse proxy and its gateway answer, byte-identical to the
    # plain-HTTP server's because it is the same file. $scheme resolves to "https"
    # here, so the API observes the caller's true scheme and its own redirection
    # guard is satisfied without a second configuration knob.
    include /etc/nginx/snippets/api-proxy.conf;

    # The immutable-asset policy and the single-page-application fallback, also
    # shared with the plain-HTTP server.
    include /etc/nginx/snippets/spa-static.conf;
}
