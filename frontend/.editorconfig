# EditorConfig for the dnn-migration Angular 19 frontend workspace (AAP 0.4.1.2).
# Reference: https://editorconfig.org
#
# SCOPE - EDITOR-FACING ONLY. Nothing in the build reads this file.
#   * `ng build` and `ng test` do not consult EditorConfig, so no value declared
#     here can affect Gate 3 (npm ci plus the production build) or Gate 4 (the
#     Karma run under headless Chrome with coverage).
#   * No linter and no formatter is in scope for this workspace. None appears in
#     the dependency manifest (AAP 0.6.2) and no validation gate runs one
#     (AAP 0.9.4). This file therefore DECLARES conventions and ENFORCES nothing;
#     it deliberately references no external tool and adds no dependency.
#   * This is the intentional opposite of the backend EditorConfig, which IS
#     build-affecting because Directory.Build.props pairs EnforceCodeStyleInBuild
#     with TreatWarningsAsErrors, so a severity set too high there breaks Gate 1.
#
# Because nothing enforces these conventions, they are the workspace's ONLY
# formatting authority, and they are therefore stated explicitly rather than left
# implicit. The repository carries no prior TypeScript or SCSS to imitate, so the
# values below are the Angular CLI conventions, matching the generator baseline
# `ng new dnn-migration --style=scss --routing=true --ssr=false` (AAP 0.5.1.6) and
# the two-space indentation already used by every committed file in this workspace.
#
# ISOLATION - why `root = true` matters here. It stops EditorConfig resolution
# from walking upward out of frontend/. That is what keeps the read-only legacy
# trees byte-identical (AAP 0.9.5): conventions meant for the 634 legacy .vb, 15
# .aspx, 147 .ascx and 139 .resx files can never leak in, and nothing declared
# here can ever leak out. The backend EditorConfig declares it for the same
# reason, so the two trees are independent by design. Consequently this workspace
# needs no repository-root EditorConfig, and none exists.

root = true

# --- Universal defaults ------------------------------------------------------
[*]
charset = utf-8
# LF everywhere. The frontend image builds on node:20-alpine and is served by
# nginx:alpine (AAP 0.9.3), so the toolchain and the runtime are Linux end to
# end; CRLF would diverge from the deployment target and from docker/nginx.conf.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# A soft guide, not a hard wrap. Kept generous so Angular decorator metadata and
# fully-typed generic signatures stay on one readable line.
max_line_length = 120

# --- TypeScript --------------------------------------------------------------
# Sources are standalone components with signal-based state, typed reactive forms
# and functional HTTP interceptors. Single quotes are the Angular CLI default and
# the convention used throughout Angular's own documentation.
[*.ts]
indent_size = 2
quote_type = single
# JetBrains IDEs honour their own namespaced key rather than quote_type.
ij_typescript_use_double_quotes = false

# --- Angular templates -------------------------------------------------------
# trim_trailing_whitespace is DISABLED here on purpose. Angular templates are
# whitespace-sensitive in places: significant space between inline elements, text
# immediately adjacent to an interpolation, and the text nodes inside the
# built-in control-flow blocks @if / @else if / @else / @for / @switch can all
# render differently once trailing whitespace is stripped. Two-space indentation
# keeps those block structures readable without altering rendered output.
[*.html]
indent_size = 2
trim_trailing_whitespace = false

# --- SCSS --------------------------------------------------------------------
# Styling is component-scoped SCSS layered over one global design-token
# stylesheet (AAP 0.9.2). Covers the global partials _tokens, _mixins, _reset,
# _layout, _forms and _tables, plus one stylesheet per component. No third-party
# UI or CSS framework is installed, so there is no vendor style to accommodate.
[*.scss]
indent_size = 2

# --- JSON --------------------------------------------------------------------
# Covers package.json, angular.json and the three tsconfig files, every one of
# which is already committed with two-space indentation. The line-length guide is
# switched off because generated JSON legitimately carries very long single-line
# values that must never be wrapped.
[*.{json,jsonc}]
indent_size = 2
max_line_length = off

# --- npm lockfile ------------------------------------------------------------
# package-lock.json is GENERATED BY npm - NEVER HAND-EDIT OR REFORMAT IT.
# Gate 3 runs `npm ci`, which fails outright without a valid lockfile, and a
# well-meaning "reformat every JSON file" pass is a realistic way to invalidate
# the integrity metadata it records. It is deliberately given NO section of its
# own and NO property override: the settings inherited above already match npm's
# own output exactly - utf-8, LF, two-space indent, one final newline and no
# trailing whitespace - so an editor honouring this file leaves the lockfile
# byte-identical, and nothing further needs to be, or should be, configured.

# --- Markdown ----------------------------------------------------------------
# trim_trailing_whitespace is DISABLED here on purpose: two trailing spaces are a
# meaningful hard line break in Markdown, and stripping them silently rewrites
# the rendered document. Prose is not held to a column ruler.
[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

# --- YAML --------------------------------------------------------------------
# Indentation is structural in YAML, so the two-space rule is restated rather
# than merely inherited.
[*.{yml,yaml}]
indent_size = 2

# --- JavaScript --------------------------------------------------------------
# karma.conf.js is the only CommonJS file in this workspace and is already
# authored with two-space indentation and single-quoted strings.
[*.js]
indent_size = 2
quote_type = single
