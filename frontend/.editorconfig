# EditorConfig for the dnn-migration workspace. Editor-facing only: no step of
# the frontend build reads this file, so nothing declared here can affect a build
# or a test run. The values are the Angular CLI conventions.
#
# `root = true` stops EditorConfig resolution from walking upward out of
# frontend/, which keeps these conventions from reaching the read-only legacy
# trees and keeps anything declared above from reaching this workspace.

root = true

# --- Universal defaults ------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.ts]
indent_size = 2
quote_type = single
ij_typescript_use_double_quotes = false

# Angular templates are whitespace-sensitive in places - space between inline
# elements, text adjacent to an interpolation, text nodes inside the built-in
# control-flow blocks - so trailing whitespace is preserved here.
[*.html]
indent_size = 2
trim_trailing_whitespace = false

[*.scss]
indent_size = 2

# The line-length guide is off for JSON because generated files legitimately
# carry very long single-line values that must not be wrapped.
[*.{json,jsonc}]
indent_size = 2
max_line_length = off

# package-lock.json is generated by npm; do not hand-edit it.

# --- Markdown ----------------------------------------------------------------
# trim_trailing_whitespace is DISABLED here on purpose: two trailing spaces are a
# meaningful hard line break in Markdown, and stripping them silently rewrites
# the rendered document. Prose is not held to a column ruler.
[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.js]
indent_size = 2
quote_type = single
