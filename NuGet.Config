<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-controlled NuGet configuration.

  WHY THIS FILE EXISTS
  Without it, package feed trust for this repository is machine-global. NuGet
  composes its settings by walking from each project directory up to the root of
  the drive and then merging the per-user file, so a checkout with no committed
  configuration inherits whatever sources the machine happens to have registered
  - on this host that is the per-user file at ~/.nuget/NuGet/NuGet.Config, which
  is outside the repository and outside review. Two consequences follow. First,
  the set of feeds that a restore may reach is a property of the machine rather
  than of the source tree, so two checkouts of the same commit can resolve the
  same package identity from different origins. Second, if any additional feed is
  ever registered on a build machine, an attacker who can publish to it can claim
  a package identity used here and win the resolution - the dependency-confusion
  substitution class of attack.

  This file removes both properties. It clears every inherited source, declares
  the single public source the dependency inventory was pinned against, and then
  states explicitly which package identities that source is permitted to serve.

  CONTAINER RESTORE
  docker/api.Dockerfile copies this file, every project manifest and every
  packages.lock.json before its restore layer, then invokes dotnet restore with
  explicit config-file and locked-mode options. The image therefore
  receives the same cleared source list, package-source mapping and exact
  transitive graph as a checkout. This is stated here because a configuration
  that protects only developer machines is not repository-controlled restore;
  the production build is the place dependency substitution matters most.

  WHAT IT DOES NOT DO
  It also does not turn advisories into build failures. NuGet auditing is left at
  the SDK default deliberately: this repository builds with
  TreatWarningsAsErrors, so promoting a future advisory to an error would stop
  delivery on a transitive package that may not even be reachable. The same
  reasoning is applied to the npm graph and is recorded in MIGRATION_NOTES.md.
-->
<configuration>

  <!--
    `clear` is the load-bearing element. Without it the sources below would be
    ADDED to whatever the per-user and machine-wide files already declare, which
    would leave the inherited-trust problem exactly as it was.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    An inherited file can disable a source by key. Clearing the disabled list
    guarantees the source declared above is actually usable, so a restore fails
    loudly on a genuine problem rather than silently falling back to a feed that
    a machine-level file happened to leave enabled.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!--
    PACKAGE SOURCE MAPPING

    With mapping in force, a package identity may only be resolved from a source
    whose pattern list claims it. There is deliberately NO bare `*` pattern: an
    identity that matches no pattern below cannot be restored at all, which is
    what makes this a control rather than a comment. Adding a dependency
    therefore requires adding its pattern here in the same commit - intended
    friction, because it is the moment at which a new package identity gets
    reviewed.

    The patterns cover the complete TRANSITIVE closure of the six projects, not
    just their direct references: 152 distinct package identities resolve for
    this solution and every one of them matches exactly one pattern below. That
    completeness is a hard requirement - an uncovered transitive identity fails
    restore with NU1100 rather than degrading gracefully.

    NuGet supports an exact identity or a trailing `*` prefix, and matches
    case-insensitively. The most specific matching pattern wins, so the narrow
    first-party prefixes below are safe to sit alongside the broad ones.

    Grouped by why each identity is present.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- Framework, ORM, data provider, hosting, testing host and analysers. -->
      <package pattern="Microsoft.*" />
      <!-- Base class library packages carried in as transitive dependencies. -->
      <package pattern="System.*" />

      <!-- API versioning: produces the mandated /api/v1 URL segment. -->
      <package pattern="Asp.Versioning.*" />
      <!-- OpenAPI document and UI. -->
      <package pattern="Swashbuckle.AspNetCore*" />
      <!-- Structured logging, and its configuration and sink packages. -->
      <package pattern="Serilog*" />
      <!-- Request DTO validation, plus its DI registration extensions. -->
      <package pattern="FluentValidation*" />
      <!-- Database probe behind the anonymous /health endpoint. -->
      <package pattern="AspNetCore.HealthChecks.*" />
      <!-- One-way password hashing; replaces the legacy reversible store. -->
      <package pattern="BCrypt.Net-Next" />

      <!-- Transitive: Microsoft.Data.SqlClient's Entra ID authentication path. -->
      <package pattern="Azure.*" />
      <!-- Transitive: EF Core design-time tooling (pluralisation, templating). -->
      <package pattern="Humanizer.*" />
      <package pattern="Mono.TextTemplating" />
      <!-- Transitive: the SQLite integration-test provider's native bundle. -->
      <package pattern="SQLitePCLRaw.*" />

      <!-- Test frameworks, mocking, assertions and coverage collection. -->
      <package pattern="xunit*" />
      <package pattern="Moq" />
      <package pattern="Castle.Core" />
      <package pattern="FluentAssertions" />
      <package pattern="coverlet.collector" />

      <!--
        Testcontainers and its transitive chain. Present so the schema-faithful
        integration path can be selected where a Docker daemon exists; it is not
        the default provider.
      -->
      <package pattern="Testcontainers*" />
      <package pattern="Docker.DotNet*" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="SSH.NET" />
      <package pattern="SshNet.Security.Cryptography" />
      <package pattern="BouncyCastle.Cryptography" />
      <package pattern="SharpZipLib" />
    </packageSource>
  </packageSourceMapping>

</configuration>
