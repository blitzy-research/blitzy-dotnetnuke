# Root ignore rules. backend/ and frontend/ are the new trees; Library/ and
# Website/ are read-only legacy inputs that must stay fully tracked. Two
# consequences must be preserved: the legacy trees commit their pre-built bin/
# assemblies, so build-output patterns are followed by explicit directory
# negations; and patterns colliding with legacy directory names (packages/,
# logs/) carry a leading slash, because git folds case wherever core.ignorecase
# is true and a bare rule would swallow tracked sources.

# -----------------------------------------------------------------------------
# Build output — required exclusions
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
node_modules/
dist/
coverage/

# -----------------------------------------------------------------------------
# Legacy committed binaries — DO NOT ignore
#
# Source-less reference assemblies the legacy build links against by HintPath.
# The negations re-include the DIRECTORIES themselves, because git cannot
# re-include a file whose parent directory is excluded: `!Website/bin/**` would
# not work. They must stay AFTER `[Bb]in/` — the last match wins.
# -----------------------------------------------------------------------------
!Website/bin/
!Library/**/bin/

# -----------------------------------------------------------------------------
# .NET build, test and tooling artefacts
# -----------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild[Ll]og.*
msbuild.log
*.user
*.userosscache
*.suo
*.userprefs
*.dbmdl
*.log
.vs/
artifacts/
project.lock.json

# Single wildcard on the `coverage*` globs, so they catch coverlet's default
# names and its format-qualified ones alike.
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info

# -----------------------------------------------------------------------------
# NuGet
# -----------------------------------------------------------------------------
*.nupkg
*.snupkg
.nuget/packages/

# The packages.config-era restore folder, anchored to the backend solution: an
# un-anchored `packages/` also matches legacy source directories on a
# case-insensitive clone. PackageReference restores into the global cache, so
# this folder should never appear and the rule is only a guard.
/backend/packages/*
!/backend/packages/build/

# EF Core migrations are never ignored. Should a migrations folder be generated
# under backend/src/, it must be committed.

# -----------------------------------------------------------------------------
# Node / Angular
#
# frontend/package-lock.json must never be ignored: `npm ci` fails outright
# without a committed lockfile. Never add `package-lock.json` or `*-lock.json`.
# -----------------------------------------------------------------------------
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.eslintcache
chrome-profiler-events*.json
speed-measure-plugin*.json

/frontend/dist/
/frontend/coverage/

# -----------------------------------------------------------------------------
# Runtime log directories
#
# Anchored for the same case-folding reason as the NuGet rule above: a bare
# `logs/` would match a legacy directory that has tracked files.
# -----------------------------------------------------------------------------
/backend/logs/
/frontend/logs/

# -----------------------------------------------------------------------------
# IDE and editor state
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Secrets and local environment overrides
#
# Real credentials never enter source control. appsettings.json and its
# environment overlays are tracked configuration; only *.local.json is ignored.
# -----------------------------------------------------------------------------

# Every machine-local environment override, at any depth: .env, .env.local,
# .env.production, .env.development, .env.test, .env.docker.local, and so on.
# `*.env` covers the dotless spelling some tooling emits (`local.env`,
# `production.env`) and is retained from the previous revision.
.env*
*.env
!**/.env.example

# Local-only configuration overlays and credential stores.
appsettings.local.json
appsettings.*.local.json
secrets.json

# Private-key and keystore containers. PEM and DER-encoded `.key` files hold
# raw private keys; PFX/P12/JKS/keystore/P8 are password-protected key stores;
# the `id_*` and `.ppk` entries are SSH identities.
*.pem
*.key
*.pfx
*.p12
*.p8
*.jks
*.keystore
*.ppk
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# Public keys are not secrets, and the `id_*.*` globs above would otherwise
# swallow the `.pub` half of every SSH key pair.
!*.pub

# -----------------------------------------------------------------------------
# Validation evidence produced by the browser automation harness.
# -----------------------------------------------------------------------------
# Screenshots, screen recordings and filmstrips written into the working tree by
# the runtime-validation tooling. They are evidence for a review, not sources the
# application builds from, and they are large binaries: a single run of the shell
# checks produced fifteen PNG and WebM files totalling several megabytes. Ignored
# so that a routine `git add` cannot pull a run's artefacts into history, where
# they would be permanent and would never be read again.
blitzy/
