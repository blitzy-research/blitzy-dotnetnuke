<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.12.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <!--
      Required by the validators that bind a policy through IOptions<T> - currently
      Validation/CreateUserRequestValidator.cs and Validation/ChangePasswordRequestValidator.cs,
      both of which consume IOptions<PasswordPolicyOptions>.

      This reference is NOT redundant. IOptions<T> is unavailable to this project without it,
      established three ways: FluentValidation.DependencyInjectionExtensions 11.12.0 depends only
      on FluentValidation and Microsoft.Extensions.DependencyInjection.Abstractions, so it does not
      supply Options transitively; Microsoft.Extensions.Options.dll is absent from the
      Microsoft.NETCore.App net8.0 reference pack that a Microsoft.NET.Sdk class library targets
      (it ships in Microsoft.AspNetCore.App, which this layer must never reference); and compiling
      IOptions<PasswordPolicyOptions> without this entry fails with CS0234 and CS0246.

      Layering is preserved. The package closes over Microsoft.Extensions.DependencyInjection.Abstractions
      and Microsoft.Extensions.Primitives only - abstractions with no ASP.NET Core and no EF Core
      surface - so Rule T1 still holds and this project still references Domain alone. 8.0.2 is the
      newest 8.0.x release of this package line, matching the solution's practice of pinning inside
      the 8.0.x band rather than to a single uniform patch.
    -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnnMigration.Domain\DnnMigration.Domain.csproj" />
  </ItemGroup>

</Project>
