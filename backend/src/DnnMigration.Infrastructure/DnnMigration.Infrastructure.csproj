<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure layer (AAP 0.4.3 / 0.6.1): references Application (and Domain
    transitively) and owns every EF Core, SQL client, password-hashing and
    health-check package. DnnDbContext never leaves this assembly.

    System.IdentityModel.Tokens.Jwt is pinned to the exact version that
    Microsoft.AspNetCore.Authentication.JwtBearer 8.0.29 resolves in the API
    layer, so JwtTokenService (AAP 0.5.1.3, Security/JwtTokenService.cs) can mint
    tokens here without dragging an ASP.NET Core framework reference into a
    class library.
  -->
  <PropertyGroup>
    <RootNamespace>DnnMigration.Infrastructure</RootNamespace>
    <AssemblyName>DnnMigration.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Explicit pin: without it the SqlServer provider resolves 5.1.x transitively. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnnMigration.Application\DnnMigration.Application.csproj" />
    <ProjectReference Include="..\DnnMigration.Domain\DnnMigration.Domain.csproj" />
  </ItemGroup>

</Project>
