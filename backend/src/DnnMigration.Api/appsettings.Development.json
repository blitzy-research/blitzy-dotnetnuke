// =============================================================================
// Development overlay. Layered on top of appsettings.json.
//
// STILL NO SECRETS. A development machine needs a connection string and a signing
// key just as a server does, and both arrive the same way - from the environment or
// from user secrets, never from a tracked file. A key committed "just for
// development" is a key committed.
//
//   export ConnectionStrings__Default='Server=localhost,1433;Database=DotNetNuke;User Id=...;Password=...;TrustServerCertificate=True;Encrypt=True'
//   export Jwt__Secret='<at least 32 random bytes, at least 8 distinct characters>'
//
// The signing key is checked at startup against a list of well-known placeholder
// fragments, so "changeme-changeme-changeme-changeme" will be refused even though
// it is long enough. Generate a real random value.
// =============================================================================
{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        // DEVELOPMENT ONLY, and a deliberate, temporary relaxation of the privacy
        // control set in the base file.
        //
        // This restores the framework's per-request entry, which includes the full
        // request line and therefore the query string. That is genuinely useful when
        // debugging routing against fabricated local data, and it is exactly what
        // must not be enabled where the query string carries a real user's email
        // address. The base file keeps it at Warning; this line does not appear in
        // the production overlay, and must not be copied into it.
        "Microsoft.AspNetCore": "Information",

        // Development only. Shows the SQL that EF Core generates, which is how a
        // mapping against the legacy schema gets verified. Parameter values remain
        // redacted: sensitive-data logging is not switched on here or anywhere.
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },

  // The Angular development server runs on its own origin and talks to this process
  // directly, without the reverse proxy that makes them same-origin in the shipped
  // topology. This is the one environment where a cross-origin policy is actually
  // required.
  //
  // Exact origin, no trailing slash, no path. Startup refuses anything else.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }

  // Swagger is not listed. The console is published automatically in development
  // from the environment name alone, so there is nothing to switch on here - and
  // adding the switch would suggest, wrongly, that it is what publishes it.

  // Https:RedirectEnabled is not listed either. It stays off: the development host
  // listens on plain HTTP, so redirecting would send the SPA's requests to a port
  // nothing is bound to.
}
