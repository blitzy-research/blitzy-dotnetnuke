{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Https": {
    "RedirectEnabled": false,
    "RedirectPort": 4443
  },
  "Serilog": {
    "MinimumLevel": {
      // The application's own verbose logging, which is the point of a development overlay.
      "Default": "Debug",
      "Override": {
        // MIGRATION: THIS ENTRY USED TO RELAX THE FRAMEWORK CHANNEL TO Information AND THAT LEAKED PERSONAL
        // DATA. The hosting layer's "Request starting" and "Request finished" entries embed the raw
        // {QueryString} in their message templates, so any search term a caller passes is written to the log
        // verbatim - and this API has query-backed reads whose natural search term IS an email address, which
        // made an ordinary user lookup write an address into the log on every request. AAP section 0.9.6
        // requires structured logging with no sensitive data, so the value is not a matter of taste.
        //
        // Warning is not a new restriction: appsettings.json already sets it and appsettings.Production.json
        // repeats it, so this overlay was the ONLY place that opted out of a default the rest of the
        // configuration had already got right. Restoring it makes every environment agree, which also means a
        // defect of this kind can no longer be present in development and absent in production - the shape of
        // problem that gets shipped precisely because the safe environment is the one nobody tests.
        //
        // Nothing observable is lost. This application logs its own request completion through
        // RequestLoggingMiddleware at Information, carrying the method, the route TEMPLATE, the status, the
        // elapsed time, the correlation identifier and - deliberately - "query string present" as a BOOLEAN
        // rather than the query string itself. That is the record a developer actually reads, it survives at
        // this level, and it is PII-free by construction rather than by redaction.
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
