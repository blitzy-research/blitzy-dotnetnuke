// =============================================================================
// Base configuration. Loaded in every environment; the environment-specific file
// is layered on top, and environment variables on top of that.
//
// NOTHING SECRET IS IN THIS FILE, OR MAY EVER BE PUT IN IT.
//
// Two values this application cannot run without are deliberately absent, so
// that they can only arrive from the environment:
//
//   ConnectionStrings__Default   the database connection string
//   Jwt__Secret                  the token signing key
//
// Both are supplied as environment variables by docker/docker-compose.yml, from
// docker/.env, which is not tracked. Absent or weak, either one stops the host at
// startup rather than being defaulted to something that appears to work. That is
// deliberate: the legacy application committed the key that decrypted every stored
// password into source control (Website/release.config), and the whole point of
// leaving these two out is that the same mistake cannot be made by editing this
// file.
//
// Comments are permitted here: the JSON configuration provider is configured to
// skip them.
// =============================================================================
{
  // ---------------------------------------------------------------------------
  // Logging. Serilog owns levels and sinks entirely.
  //
  // There is deliberately no "Logging" section. The framework's own section would
  // be read by nobody once Serilog is installed as the logging provider, and a
  // configuration block that looks like it controls log levels while controlling
  // nothing is worse than its absence.
  // ---------------------------------------------------------------------------
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // NOT noise reduction. A PRIVACY CONTROL.
        //
        // The framework's own diagnostic logger writes one entry per request at
        // Information level containing the full request line - including the query
        // string. Several endpoints of this API take a free-text filter, so those
        // entries would write user-supplied search terms, and therefore email
        // addresses and account names, into the highest-volume log the application
        // produces. This application's own request-log stage exists precisely to
        // record the same request without its query string; leaving the framework's
        // entry enabled would restore exactly what that stage omits and make the
        // omission pointless.
        //
        // Raising this to Information re-enables that disclosure. Do not do it
        // outside development.
        "Microsoft.AspNetCore": "Warning",

        // Also a privacy control. The command logger writes the SQL text of every
        // query it executes. Parameter values are redacted unless sensitive-data
        // logging is switched on - which it is not, anywhere - but the statement
        // text alone still describes the schema and the access pattern in detail,
        // once per query, at Information.
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

        // The migration and model-building loggers are useful once, at startup, and
        // then never again.
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // One JSON object per line, written to standard output. This is the shape
          // a container log collector can parse; a human-formatted line cannot be
          // queried by field, which defeats the purpose of structured logging.
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  // ---------------------------------------------------------------------------
  // Host filtering.
  //
  // Open on purpose, and this is not laziness. This application is multi-tenant and
  // decides which tenant it is serving from the request's host name, matched
  // against the portal alias table in the database. That table IS the host
  // allowlist, it is authoritative, and it changes when an administrator adds an
  // alias. A second, static allowlist here would have to be kept in step with it by
  // hand; the two would drift, and the failure mode of the drift is a tenant that
  // exists in the database and is refused at the door.
  //
  // Nothing is actually served to an unrecognised host: the tenant resolution stage
  // refuses a host it cannot match, so an unknown host receives a refusal that
  // names no portal and confirms nothing.
  // ---------------------------------------------------------------------------
  "AllowedHosts": "*",

  // ---------------------------------------------------------------------------
  // Token issuance. The signing key is NOT here - see the header of this file.
  //
  // Issuer and audience are intentionally the same value. This API is the only
  // consumer of the tokens it issues, so there is one audience and it is itself;
  // the repository's own published configuration records the same arrangement.
  // ---------------------------------------------------------------------------
  "Jwt": {
    "Issuer": "DnnMigration",
    "Audience": "DnnMigration",

    // Minutes. Bounded at startup to 1..60. Sixty is both the documented default
    // and the timeout the legacy forms ticket used, so this is the legacy session
    // length carried over rather than a new choice.
    "ExpirationMinutes": 60,

    // Days. Bounded at startup to 1..30. This is an ABSOLUTE ceiling on a refresh
    // family: it is fixed when the family is created and every rotation inherits
    // it unchanged, so continued use cannot extend a session beyond this.
    "RefreshTokenExpirationDays": 7
  },

  // ---------------------------------------------------------------------------
  // Password policy - the legacy policy, preserved exactly.
  //
  // These values are copied from the legacy membership provider registration and
  // are NOT hardened here. Tightening a password policy during a migration locks
  // out users whose existing credentials the legacy installation accepted, which
  // turns a migration into an outage. Hardening is a separate, deliberate decision
  // to be taken after the migration, not smuggled into it.
  //
  // Startup treats the minimum length as a FLOOR as well as a value: it may be
  // raised but not lowered, so a deployment cannot accept credentials the legacy
  // installation would have rejected.
  //
  // The two "Requires" flags must both stay false. Nothing in this application
  // enforces either of them, so a true value would be a control that appears
  // active and is not; startup refuses it for that reason.
  // ---------------------------------------------------------------------------
  "PasswordPolicy": {
    "MinRequiredPasswordLength": 7,
    "MinRequiredNonAlphanumericCharacters": 0,
    "RequiresQuestionAndAnswer": false,
    "RequiresUniqueEmail": false,
    "PasswordResetEnabled": true,

    // Empty means no strength rule, which is the legacy behaviour. An empty pattern
    // matches everything, so applying one would be a no-op that reads as
    // enforcement.
    "PasswordStrengthRegularExpression": "",

    // The legacy provider registration declares neither of these, so the effective
    // legacy values were the framework defaults of five attempts inside a ten-minute
    // window. Those measured values are reproduced here so an unconfigured deployment
    // behaves as the legacy installation did; the counting itself belongs to the
    // external membership store.
    "MaxInvalidPasswordAttempts": 5,
    "PasswordAttemptWindowMinutes": 10
  },

  // ---------------------------------------------------------------------------
  // Portal defaults, carried over from the legacy installation.
  //
  // HomeDirectoryFormat must keep its {0} placeholder. Startup refuses a format
  // without it, because a format that has lost the placeholder expands to the same
  // directory for every tenant - which is a cross-tenant file leak expressed as a
  // configuration typo.
  // ---------------------------------------------------------------------------
  "Portal": {
    "AdminTemplateFileName": "admin.template",
    "HomeDirectoryFormat": "Portals/{0}",
    "UnauthenticatedRoleName": "Unauthenticated Users",
    "AllUsersRoleName": "All Users"
  },

  // ---------------------------------------------------------------------------
  // Caching.
  //
  // Multiplier applied to each cached item's base expiry, reproducing the legacy
  // performance setting. Three is the legacy default ("moderate"). Zero is a
  // legitimate value and disables caching entirely, exactly as it did before.
  // ---------------------------------------------------------------------------
  "Caching": {
    "PerformanceMultiplier": 3
  },

  // ---------------------------------------------------------------------------
  // Cross-origin access.
  //
  // Empty by default, and correct that way. In the shipped topology the reverse
  // proxy serves the application and proxies /api/ to this process, so the browser
  // and the API share an origin and no cross-origin policy is needed at all. An
  // origin is added only by a deployment that serves the two from different
  // origins.
  //
  // Every entry must be an exact scheme-host-port origin. A wildcard is refused at
  // startup, and credentials are never enabled on the policy, so the
  // wildcard-plus-credentials combination is unreachable from configuration.
  // ---------------------------------------------------------------------------
  "Cors": {
    "AllowedOrigins": []
  },

  // ---------------------------------------------------------------------------
  // Interactive API documentation.
  //
  // Off. The console is published automatically in development and, outside
  // development, only when this is true - and even then only to callers who have
  // already authenticated. It is an unauthenticated, machine-readable description
  // of every endpoint and error shape the API accepts, so it is not something to
  // leave on by default.
  // ---------------------------------------------------------------------------
  "Swagger": {
    "Enabled": false
  },

  // ---------------------------------------------------------------------------
  // How often credential-bearing requests are accepted.
  //
  // The window is partitioned by the address this process observes. Behind the
  // reverse proxy this solution ships that address is the proxy's, so the budget is
  // shared by the whole deployment and is sized accordingly. A deployment that
  // declares its proxies under ForwardedHeaders recovers the caller's own address
  // and can tighten this considerably.
  //
  // Removing either key restores the shipped default; a zero or negative value is
  // refused while the host is starting, because zero permits would refuse every
  // sign-in and a non-positive window is not a period.
  // ---------------------------------------------------------------------------
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },

  // ---------------------------------------------------------------------------
  // Transport security.
  //
  // Off, because in the shipped topology TLS terminates at the reverse proxy in
  // front of this process, and the container's health probe reaches this process
  // over plain HTTP on the published port. Redirecting would answer that probe with
  // a redirect to a port nothing is listening on; the probe would never report
  // healthy and the front-end container, which waits for it, would never start.
  //
  // Set this to true only in a deployment that terminates TLS in this process.
  // Strict-transport-security headers are sent outside development regardless, and
  // need no switch: that stage ignores plain-HTTP and loopback requests, so it
  // cannot affect the probe.
  // ---------------------------------------------------------------------------
  "Https": {
    "RedirectEnabled": false
  }
}
