<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The only project in the solution built with the Web SDK; Domain, Application and
    Infrastructure use plain Microsoft.NET.Sdk.

    CONTAINER ENTRYPOINT CONTRACT - do not add an AssemblyName property here. That property,
    and that property alone, names the emitted assembly; the SDK defaults it to this file's
    name, which is what makes the published assembly DnnMigration.Api.dll, the exact name
    docker/api.Dockerfile starts. Declaring it adds a second place the name can drift from,
    and no compiler catches the mismatch. The same path is spelled in backend/DnnMigration.sln
    and in the integration test project's project reference, and the Alpine build stage is
    case-sensitive, so the casing must not change either.

    Build policy is inherited from backend/Directory.Build.props, which is why this file
    declares no PropertyGroup. Any diagnostic that survives a Release build with warnings
    promoted to errors is fixed in code, never suppressed here.

    The API image runs as an unprivileged user and listens on 8080, so nothing added here may
    require root, a port below 1024, or a writable path outside the application directory.
    Secrets arrive as environment variables, never from a project-scoped secret store.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.29" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <!--
    Two references, and no more. Application supplies the service abstractions, DTOs and
    options the controllers bind to. Infrastructure is referenced so that the composition root
    this project must declare can register the persistence and security services, among them
    the database health check served at /health, which has to remain anonymous because the
    frontend container's start-up waits on it.

    Domain is deliberately not named: it arrives transitively, and listing it would advertise
    that the API may consume domain entities directly instead of crossing the boundary through
    DTOs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DnnMigration.Application\DnnMigration.Application.csproj" />
    <ProjectReference Include="..\DnnMigration.Infrastructure\DnnMigration.Infrastructure.csproj" />
  </ItemGroup>

</Project>
