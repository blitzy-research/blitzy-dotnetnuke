<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API layer (AAP 0.4.3 / 0.6.1): references Application and Infrastructure and
    owns the JWT bearer, OpenAPI/Swagger, API-versioning and Serilog packages.
    Controllers stay thin - no business logic (Rule T2).

    AssemblyName MUST remain DnnMigration.Api: docker/api.Dockerfile declares
    ENTRYPOINT ["dotnet", "DnnMigration.Api.dll"].
  -->
  <PropertyGroup>
    <RootNamespace>DnnMigration.Api</RootNamespace>
    <AssemblyName>DnnMigration.Api</AssemblyName>
    <UserSecretsId>dnnmigration-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.29" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnnMigration.Application\DnnMigration.Application.csproj" />
    <ProjectReference Include="..\DnnMigration.Infrastructure\DnnMigration.Infrastructure.csproj" />
  </ItemGroup>

</Project>
