<Project>

  <!--
    Build policy for every project in the DnnMigration solution. MSBuild imports
    this file by walking upward from each project directory, so no .csproj needs
    to restate any property below, and none should override one to make itself
    build.

    The file must stay at backend/. A copy at the repository root would also be
    imported into the legacy .NET Framework project under Library/, injecting
    net8.0, nullable reference types and warnings-as-errors into a project that
    cannot survive them.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      This file adds exactly two suppressions to whatever the SDK and the
      individual project already contribute; the leading $(NoWarn) reference
      appends rather than replaces, so removing it would discard those inherited
      values.

        CS8618  entities and DTOs are materialised by EF Core and
                System.Text.Json, so the compiler cannot see the assignment that
                does happen.
        CS1591  required for GenerateDocumentationFile to coexist with
                warnings-as-errors: otherwise every undocumented public member
                fails the build.

      Widen this list for nothing else. A different diagnostic under a Release
      build with warnings promoted to errors means the code needs fixing, not a
      new suppression, a per-project override or a file-level pragma. (Command
      switches are described in prose because XML forbids a double hyphen inside
      a comment.)
    -->
    <NoWarn>$(NoWarn);CS8618;CS1591</NoWarn>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Promotes backend/.editorconfig from an IDE convenience to a build-time
         contract. That file holds its style rules at suggestion severity so the
         warning policy above cannot turn formatting into a build failure. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
