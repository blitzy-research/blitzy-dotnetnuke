<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>

  <!--
    TEST-ONLY project references.

    Application is referenced because the AAP places the service, validator and
    mapper suites here (AAP 0.4.1.1: tests/DnnMigration.UnitTests/{Application,
    Validation,Mapping}), and those exercise Application types directly.

    Infrastructure is referenced because the AAP also places the CONCRETE security
    suites here - tests/DnnMigration.UnitTests/Security/{BcryptPasswordHasherTests,
    JwtTokenServiceTests, PermissionEvaluatorTests}.cs - whose subjects are
    Infrastructure/Security/{BcryptPasswordHasher,JwtTokenService,
    PermissionEvaluator}.cs. Those implementations cannot reach this project
    through Application, because Application references only Domain (AAP 0.5.2.2),
    so without this reference the planned tests could only be written against the
    Domain interfaces - substituting interface fakes for the concrete algorithms
    they are meant to prove. Hash round-trip, token-claim and permission-resolution
    behaviour is only assertable against the real implementations.

    This does NOT relax the production layering that AAP Rule T1 mandates. Rule T1
    constrains the four production projects, whose graph is unchanged and remains
    compiler-enforced: Domain references nothing, Application references Domain,
    Infrastructure references Domain and Application, Api references Application
    and Infrastructure. A test project is a leaf of that graph - nothing references
    it - so it cannot create a cycle or let Application see Infrastructure. The
    sibling integration-test project already applies the same principle,
    referencing Api directly for WebApplicationFactory<Program>.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DnnMigration.Application\DnnMigration.Application.csproj" />
    <ProjectReference Include="..\..\src\DnnMigration.Infrastructure\DnnMigration.Infrastructure.csproj" />
  </ItemGroup>

</Project>
