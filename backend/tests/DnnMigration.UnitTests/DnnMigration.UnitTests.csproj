<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>

  <!--
    TEST-ONLY project reference. This project references DnnMigration.Application
    and nothing else, which is exactly the test graph AAP 0.5.2.2 authorises
    (Application -> UnitTests, Api -> IntegrationTests).

    Application brings Domain with it, so the service, validator, mapper and domain
    suites placed here by AAP 0.4.1.1 compile against everything they need.

    Infrastructure is deliberately NOT referenced. The concrete security components
    it owns are internal to that assembly and are proved end to end by the
    integration project, which reaches them legitimately through its Api reference
    and the DI container: real BCrypt hashing through the password endpoint, real
    JWT issuance and claims through /api/v1/auth, and permission allow/deny through
    protected endpoints. The Security suites in this project therefore assert the
    contracts and configured policies those components implement and consume -
    IPasswordHasher semantics, JwtOptions validity, ITokenService/LoginResponse
    shape and PermissionKey resolution - all of which are reachable from
    Application and Domain. Do not add an Infrastructure reference here.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DnnMigration.Application\DnnMigration.Application.csproj" />
  </ItemGroup>

</Project>
